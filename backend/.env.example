# Copy to .env and fill in. .env is gitignored; only this template is committed.

# Environment: development | testing | production
SENTINEL_ENVIRONMENT=development

# Database. Leave empty in dev to use sqlite:///sentinel_dev.db.
# Production example: postgresql://user:pass@host:5432/sentinel
DATABASE_URL=

# Secrets. REQUIRED in production — the app refuses to start with the built-in
# defaults. Generate strong random values (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
SECRET_KEY=
JWT_SECRET_KEY=

# Bootstrap admin account, created once by migration 48b247de5e75 on a fresh
# database (idempotent — a no-op on every later `flask db upgrade`). REQUIRED
# in production: the migration refuses to run without DEFAULT_ADMIN_PASSWORD
# set, rather than silently seed an admin with a guessable password. In
# development, both fall back to admin@sentinel.local / ChangeMe123! if left
# blank. Log in with this account once, then create/promote real accounts
# via the User Management page — there is no seeded default manager account.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# CORS. Dev is permissive ('*') by default; in production set a comma-separated
# allowlist of frontend origins, e.g. https://app.example.com
CORS_ORIGINS=http://localhost:3000

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Echo SQL to the console in development (noisy): true | false
SQLALCHEMY_ECHO=false

# Rate-limit storage. Defaults to in-memory; set to a shared store in production.
# Example: redis://localhost:6379
RATELIMIT_STORAGE_URI=
