# Copy to .env and fill in. .env is gitignored; only this template is committed.

# Environment: development | testing | production
SENTINEL_ENVIRONMENT=development

# Database. Leave empty in dev to use sqlite:///sentinel_dev.db.
# Production example: postgresql://user:pass@host:5432/sentinel
DATABASE_URL=

# Secrets. REQUIRED in production — the app refuses to start with the built-in
# defaults. Generate strong random values (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
SECRET_KEY=
JWT_SECRET_KEY=

# CORS. Dev is permissive ('*') by default; in production set a comma-separated
# allowlist of frontend origins, e.g. https://app.example.com
CORS_ORIGINS=http://localhost:3000

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Echo SQL to the console in development (noisy): true | false
SQLALCHEMY_ECHO=false

# Rate-limit storage. Defaults to in-memory; set to a shared store in production.
# Example: redis://localhost:6379
RATELIMIT_STORAGE_URI=
